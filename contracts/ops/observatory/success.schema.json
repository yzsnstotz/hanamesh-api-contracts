        "status",
        "lastSuccessAt",
        "lastFailureAt",
        "latestResult",
        "latestResultAt",
        "failures",
        "failureWindow",
        "paused",
        "reason",
        "results"
      ],
      "properties": {
        "instanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "moduleId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9.-]{0,63}$"
