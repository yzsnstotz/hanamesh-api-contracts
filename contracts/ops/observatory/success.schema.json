            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[A-Z][A-Z0-9_]{0,95}|[0-9][0-9A-Z]{4})$",
              "maxLength": 96
            },
