              "maxLength": 24
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "healthy",
            "degraded",
            "paused",
            "failed",
            "unknown"
          ]
        },
        "lastSuccessAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$",
              "maxLength": 24
            },
            {
              "type": "null"
            }
          ]
        },
        "lastFailureAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$",
              "maxLength": 24
            },
            {
              "type": "null"
            }
          ]
        },
        "latestResult": {
          "enum": [
            "ok",
            "failed",
            "skipped",
            null
          ]
        },
        "latestResultAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$",
              "maxLength": 24
            },
            {
              "type": "null"
            }
          ]
        },
        "failures": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "failureWindow": {
          "anyOf": [
            {
              "$ref": "#/definitions/window"
            },
            {
              "type": "null"
            }
          ]
        },
        "paused": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "results": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/jobResult"
          }
        },
        "activity": {
          "$ref": "#/definitions/jobActivity"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "coverageStartedAt": {
                "type": "null"
              },
              "lastSuccessAt": {
                "type": "null"
              },
              "lastFailureAt": {
                "type": "null"
              },
              "latestResult": {
                "type": "null"
              },
              "latestResultAt": {
                "type": "null"
              },
              "failures": {
                "type": "null"
              },
              "failureWindow": {
                "type": "null"
              },
              "paused": {
                "type": "null"
              },
              "status": {
                "const": "unknown"
              },
              "results": {
                "maxItems": 0
              },
              "source": {
                "properties": {
                  "asOf": {
                    "type": "null"
                  }
                }
              }
            }
          }
        }
      ]
    },
