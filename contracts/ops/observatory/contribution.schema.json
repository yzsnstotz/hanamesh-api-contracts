  "definitions": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "port",
        "definition",
        "asOf"
      ],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,63}$"
        },
        "port": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
