{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "scope",
    "requestedWindow",
    "coveredWindow",
    "snapshotId",
    "revision",
    "asOf",
    "complete",
    "missing",
    "nextAfter"
  ],
  "properties": {
    "schema": {
      "const": "hanamesh-ops-coverage-v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "port",
        "definition"
      ],
      "properties": {
        "module": {
          "$ref": "#/definitions/id"
        },
        "port": {
          "$ref": "#/definitions/id"
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentId",
        "scopeId"
      ],
      "properties": {
        "deploymentId": {
          "$ref": "#/definitions/id"
        },
        "scopeId": {
          "$ref": "#/definitions/id"
        }
      }
    },
    "requestedWindow": {
      "$ref": "#/definitions/window"
    },
    "coveredWindow": {
      "anyOf": [
        {
          "$ref": "#/definitions/window"
        },
        {
          "type": "null"
        }
      ]
    },
    "snapshotId": {
      "anyOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "anyOf": [
        {
          "$ref": "#/definitions/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "asOf": {
      "anyOf": [
        {
          "$ref": "#/definitions/instant"
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "missing": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/id"
      },
      "maxItems": 200,
      "uniqueItems": true
    },
    "nextAfter": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "chainAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId",
        "blockNumber",
        "blockHash",
        "confirmations",
        "reorgCheckedThrough"
      ],
      "properties": {
        "chainId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$(?![\\s\\S])"
        },
        "confirmations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reorgCheckedThrough": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "missing": {
            "maxItems": 0,
            "type": "array"
          },
          "coveredWindow": {
            "$ref": "#/definitions/window"
          },
          "snapshotId": {
            "$ref": "#/definitions/id"
          },
          "revision": {
            "$ref": "#/definitions/id"
          },
          "asOf": {
            "$ref": "#/definitions/instant"
          }
        }
      },
      "else": {
        "properties": {
          "missing": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "nextAfter": {
            "type": "string"
          }
        }
      },
      "then": {
        "properties": {
          "coveredWindow": {
            "$ref": "#/definitions/window"
          },
          "snapshotId": {
            "$ref": "#/definitions/id"
          },
          "revision": {
            "$ref": "#/definitions/id"
          },
          "asOf": {
            "$ref": "#/definitions/instant"
          }
        }
      }
    }
  ],
  "definitions": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    },
    "instant": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(\\.\\d{1,3})?Z$(?![\\s\\S])"
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/definitions/instant"
        },
        "to": {
          "$ref": "#/definitions/instant"
        }
      }
    }
  }
}
