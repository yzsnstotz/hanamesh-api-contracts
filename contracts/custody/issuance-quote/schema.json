            "type": "object",
            "additionalProperties": false,
            "required": [
              "amount",
              "userAmount",
              "creatorAmount",
              "launchInitiatorAmount",
              "holderId",
              "isIssuer",
              "isSelf",
              "isLaunchInitiator",
              "qualificationSources",
              "rank"
            ],
            "properties": {
              "amount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "userAmount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "creatorAmount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "launchInitiatorAmount": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "holderId": {
                "type": "string",
                "minLength": 1
              },
              "isIssuer": {
                "type": "boolean"
              },
              "isSelf": {
                "type": "boolean"
              },
              "isLaunchInitiator": {
                "type": "boolean"
              },
