{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "quoteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "quote",
        "issuerEarlyReleaseOptIn"
      ],
      "properties": {
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "issuerEarlyReleaseOptIn": {
          "type": "boolean"
        }
      }
    },
    "freezeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "quote",
        "issuerEarlyReleaseOptIn",
        "snapshotHash"
      ],
      "properties": {
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "issuerEarlyReleaseOptIn": {
          "type": "boolean"
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
        },
        "emptyConfirmation": {
          "type": "boolean"
        }
      }
    },
    "launchSupplyQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "quote",
        "issuerEarlyReleaseOptIn",
        "allocationState"
      ],
      "properties": {
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "issuerEarlyReleaseOptIn": {
          "enum": [
            "true",
            "false"
          ]
        },
        "allocationState": {
          "enum": [
            "quote",
            "frozen"
          ]
        }
      }
    },
    "recipientsQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "after": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8})$"
        },
        "limit": {
          "type": "string",
          "pattern": "^([1-9]|[1-4][0-9]|50)$"
        }
      }
    },
    "quote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hanaId",
        "requestId",
        "principalId",
        "schema",
        "campaignId",
        "issuerEarlyReleaseOptIn",
        "status",
        "contributorCount",
        "estimatedSeconds",
        "queuedAt",
        "queuePosition",
        "queueEtaSeconds",
        "computeStartedAt",
        "pointsCutoffAt",
        "heldAt",
        "expiresAt",
        "frozenAt",
        "signatureDeadline",
        "serverNow",
        "failure",
        "summary",
        "allocation"
      ],
      "properties": {
        "hanaId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "const": "hanamesh-issuance-quote-v1"
        },
        "campaignId": {
          "type": "string",
          "minLength": 1
        },
        "issuerEarlyReleaseOptIn": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "queued",
            "computing",
            "held",
            "signed",
            "expired",
            "failed"
          ]
        },
        "contributorCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "estimatedSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "queuedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "queuePosition": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "queueEtaSeconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "computeStartedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "pointsCutoffAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "heldAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozenAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "signatureDeadline": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "serverNow": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "failure": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "message"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/summary"
            },
            {
              "type": "null"
            }
          ]
        },
        "allocation": {
          "anyOf": [
            {
              "$ref": "#/$defs/allocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "held",
                  "signed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "allocation": {
                "$ref": "#/$defs/allocation"
              },
              "summary": {
                "$ref": "#/$defs/summary"
              },
              "heldAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              },
              "expiresAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              }
            }
          },
          "else": {
            "properties": {
              "allocation": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failure": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "message": {
                    "type": "string"
                  }
                }
              },
              "summary": {
                "$ref": "#/$defs/summary"
              }
            }
          },
          "else": {
            "properties": {
              "failure": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "signed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "frozenAt": {
                "type": "string",
                "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
              }
            }
          },
          "else": {
            "properties": {
              "signatureDeadline": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hanaId",
        "requestId",
        "principalId",
        "schema",
        "status",
        "computedAt",
        "heldAt",
        "expiresAt",
        "frozenAt",
        "failureCode",
        "contributorCount",
        "recipientCount",
        "budget",
        "categories",
        "top10Amount",
        "issuer",
        "snapshotHash"
      ],
      "properties": {
        "hanaId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "const": "hanamesh-issuance-quote-summary-v1"
        },
        "status": {
          "enum": [
            "queued",
            "computing",
            "held",
            "signed",
            "expired",
            "failed"
          ]
        },
        "computedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "heldAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "expiresAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "frozenAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "failureCode": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "contributorCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "recipientCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "budget": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "categories": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "contributors",
                "author",
                "launchInitiator",
                "platformWithheld",
                "roundingDust"
              ],
              "properties": {
                "contributors": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "author": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "launchInitiator": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "platformWithheld": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "roundingDust": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "top10Amount": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuer": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "userAmount",
                "creatorAmount",
                "launchInitiatorAmount"
              ],
              "properties": {
                "amount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "userAmount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "creatorAmount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "launchInitiatorAmount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshotHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "allocation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/allocationDetails"
        }
      ],
      "required": [
        "issuer"
      ],
      "properties": {
        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "userAmount",
            "creatorAmount",
            "launchInitiatorAmount",
            "shareBps",
            "budget"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "userAmount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "creatorAmount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "launchInitiatorAmount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "shareBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "budget": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        }
      },
      "unevaluatedProperties": false
    },
    "frozenAllocation": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/allocationDetails"
        }
      ],
      "required": [
        "issuer",
        "reservationId",
        "frozenAt",
        "quoteExpiresAt",
        "issuerEarlyReleaseOptIn",
        "confirmation"
      ],
      "properties": {
        "issuer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amount",
            "shareBps",
            "budget"
          ],
          "properties": {
            "amount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "userAmount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "creatorAmount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "launchInitiatorAmount": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "shareBps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "budget": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          }
        },
        "reservationId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "frozenAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "quoteExpiresAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "issuerEarlyReleaseOptIn": {
          "type": "boolean"
        },
        "confirmation": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "principalId",
                "confirmedAt",
                "copyVersion",
                "accepted"
              ],
              "properties": {
                "principalId": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmedAt": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                },
                "copyVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "accepted": {
                  "const": true
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "zeroQualified": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known",
        "active",
        "severity",
        "requiresIssuerConfirmation",
        "copy"
      ],
      "properties": {
        "known": {
          "const": true
        },
        "active": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "danger",
            "none"
          ]
        },
        "requiresIssuerConfirmation": {
          "type": "boolean"
        },
        "copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "version",
            "heading",
            "message",
            "confirmationLabel"
          ],
          "properties": {
            "code": {
              "const": "ZERO_QUALIFIED_PLATFORM_RESERVE"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "heading": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "confirmationLabel": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    },
    "qualificationSources": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "userPoints",
            "creatorMirrorPoints",
            "claimBonusPoints",
            "totalPoints"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "userPoints": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "creatorMirrorPoints": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "claimBonusPoints": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            },
            "totalPoints": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "userPoints",
            "creatorMirrorPoints",
            "claimBonusPoints",
            "totalPoints"
          ],
          "properties": {
            "status": {
              "const": "legacy-unavailable"
            },
            "userPoints": {
              "type": "null"
            },
            "creatorMirrorPoints": {
              "type": "null"
            },
            "claimBonusPoints": {
              "type": "null"
            },
            "totalPoints": {
              "type": "null"
            }
          }
        }
      ]
    },
    "recipient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "userAmount",
        "creatorAmount",
        "launchInitiatorAmount",
        "holderId",
        "isIssuer",
        "isSelf",
        "isLaunchInitiator",
        "qualificationSources"
      ],
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "userAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "creatorAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "launchInitiatorAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "holderId": {
          "type": "string",
          "minLength": 1
        },
        "isIssuer": {
          "type": "boolean"
        },
        "isSelf": {
          "type": "boolean"
        },
        "isLaunchInitiator": {
          "type": "boolean"
        },
        "qualificationSources": {
          "$ref": "#/$defs/qualificationSources"
        }
      }
    },
    "recipients": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "requestId",
        "snapshotHash",
        "total",
        "items",
        "next"
      ],
      "properties": {
        "schema": {
          "const": "hanamesh-issuance-quote-recipients-v1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
        },
        "total": {
          "type": "integer",
          "minimum": 0
