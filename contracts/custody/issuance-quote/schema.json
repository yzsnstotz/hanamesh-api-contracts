                "$ref": "#/$defs/qualificationSources"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "maxItems": 50
        },
        "next": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "launchSupply": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "scope",
        "allocation",
        "pointsBps",
        "airdropAmount",
        "recipientsAmount",
        "airdropRedirectToPlatform",
        "redirectIsSubsetOfAirdrop",
        "route",
        "zeroQualified",
        "executed",
        "source",
        "unknowns"
      ],
      "properties": {
        "schema": {
          "const": "hanamesh-custody-launch-supply-v1"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deploymentId",
            "chainId",
            "launcher",
            "hanaId",
            "requestId",
            "campaignId",
            "allocationState",
            "snapshotHash"
          ],
          "properties": {
            "deploymentId": {
              "type": "string",
              "minLength": 1
            },
            "chainId": {
              "type": "integer",
              "minimum": 1
            },
            "launcher": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "hanaId": {
              "type": "string",
              "minLength": 1
            },
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "campaignId": {
              "type": "string",
              "minLength": 1
            },
            "allocationState": {
              "enum": [
                "quote",
                "frozen"
              ]
            },
            "snapshotHash": {
              "type": "string",
              "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
            }
          }
        },
        "allocation": {
          "oneOf": [
            {
              "$ref": "#/$defs/allocation"
            },
            {
              "$ref": "#/$defs/frozenAllocation"
            }
          ]
        },
        "pointsBps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "airdropAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "recipientsAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "airdropRedirectToPlatform": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "redirectIsSubsetOfAirdrop": {
          "const": true
        },
        "route": {
          "enum": [
            "ordinary",
            "empty",
            "no-airdrop"
          ]
        },
        "zeroQualified": {
          "$ref": "#/$defs/zeroQualified"
        },
        "executed": {
          "const": false
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "schema",
            "evidence",
            "policyVersion",
            "settingsVersion",
            "asOf",
            "frozenAt"
          ],
          "properties": {
            "owner": {
              "const": "custody"
            },
            "schema": {
              "const": "hanamesh-issuance-allocation-preview-v1"
            },
            "evidence": {
              "enum": [
                "FIXTURE",
                "TRUSTED"
              ]
            },
            "policyVersion": {
              "type": "integer",
              "minimum": 0
            },
            "settingsVersion": {
              "type": "integer",
              "minimum": 0
            },
            "asOf": {
              "type": "string",
              "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
            },
            "frozenAt": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "const": "execution"
                  },
                  "reason": {
                    "const": "CHAIN_EXECUTION_NOT_OBSERVED"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "reason"
                ],
                "properties": {
                  "field": {
                    "const": "walletBalances"
                  },
                  "reason": {
                    "const": "WALLET_BALANCES_NOT_OBSERVED"
                  }
                }
              }
            ]
          }
        }
      }
