{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 384,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "serverNow",
        "items",
        "nextCursor"
      ],
      "properties": {
        "schema": {
          "const": "hanamesh-custody-pending-registration-v1"
        },
        "serverNow": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/right"
          },
          "maxItems": 50
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 384,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "right": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignId",
        "entitlementId",
        "hanaId",
        "requestId",
        "chainId",
        "releaseAddress",
        "pluginName",
        "tokenSymbol",
        "total",
        "openedAt",
        "registrationDeadline",
        "committedAccount",
        "registered",
        "swept"
      ],
      "properties": {
        "campaignId": {
          "type": "string",
          "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
        },
        "entitlementId": {
          "type": "string",
          "pattern": "^0x(?!0{64}$)[0-9a-fA-F]{64}$"
        },
        "hanaId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "chainId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "releaseAddress": {
          "type": "string",
          "pattern": "^0x(?!0{40}$)[0-9a-f]{40}$"
        },
        "pluginName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "tokenSymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\p{Cc}\\p{Cf}]+$"
        },
        "total": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "openedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "registrationDeadline": {
          "type": "string",
          "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
        },
        "committedAccount": {
          "const": "0x0000000000000000000000000000000000000000"
        },
        "registered": {
          "const": false
        },
        "swept": {
          "const": false
        }
      }
    }
  }
}
