{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanamesh.dev/contracts/issuer/read-v1",
  "$ref": "#/$defs/page",
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "uint": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "name",
        "symbol",
        "decimals"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "attachedAddresses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "namespace",
        "version",
        "maxWallets",
        "addresses"
      ],
      "properties": {
        "schema": {
          "const": "hanamesh-own-attached-addresses-v1"
        },
        "namespace": {
          "const": "eip155"
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxWallets": {
          "const": 10
        },
        "addresses": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{40}$"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hanaKey",
        "hanaId",
        "displayName",
        "status"
      ],
      "properties": {
        "hanaKey": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "hanaId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayName": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "available",
            "not-found"
          ]
        }
      }
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "deploymentId",
        "maxKeys",
        "items"
      ],
      "properties": {
        "schema": {
          "const": "hanamesh-issued-hana-profiles-v1"
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxKeys": {
          "const": 50
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "hanaKey",
              "hanaId",
              "displayName",
              "status"
            ],
            "properties": {
              "hanaKey": {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              "hanaId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "displayName": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "status": {
                "enum": [
                  "available",
                  "not-found"
                ]
              }
            }
          }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "chainId",
        "mode",
        "evidence",
        "sourceCommit",
        "sourceRef",
        "blockNumber",
        "blockHash",
        "blockTimestamp",
        "confirmations",
        "requiredConfirmations",
        "launcher",
        "fromBlock"
      ],
      "properties": {
        "protocol": {
          "const": "release-quote-v2"
        },
        "chainId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "mode": {
          "enum": [
            "test-only",
            "production"
          ]
        },
        "evidence": {
          "enum": [
            "FIXTURE",
            "READ_ONLY_RPC"
          ]
        },
        "sourceCommit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "blockTimestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "confirmations": {
          "type": "integer",
          "minimum": 0
        },
        "requiredConfirmations": {
          "type": "integer",
          "minimum": 1
        },
        "launcher": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "fromBlock": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hanaKey",
        "requestId",
        "issuer",
        "token",
        "bond",
        "pool",
        "quote",
        "launchFeeWei",
        "issuedAt",
        "issuedTimestamp",
        "transactionHash",
        "eventId",
        "blockNumber",
        "blockHash",
        "phase",
        "sold",
        "sales",
        "earlyReleaseAllowed",
        "releaseStartedAt",
        "releaseStartSource",
        "migratedAt",
        "profile"
      ],
      "properties": {
        "hanaKey": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "requestId": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "issuer": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "token": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "name",
            "symbol",
            "decimals"
          ],
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "bond": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "pool": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{40}$"
        },
        "quote": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "address",
            "name",
            "symbol",
            "decimals"
          ],
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "symbol": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        "launchFeeWei": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "issuedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "issuedTimestamp": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "transactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "phase": {
          "enum": [
            "bond",
            "migrated",
            "inactive"
          ]
        },
        "sold": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "sales": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        "earlyReleaseAllowed": {
          "type": "boolean"
        },
        "releaseStartedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "releaseStartSource": {
          "enum": [
            "early-release",
            "migration",
            null
          ]
        },
        "migratedAt": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hanaKey",
            "hanaId",
            "displayName",
            "status"
          ],
          "properties": {
            "hanaKey": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "hanaId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "displayName": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "enum": [
                "available",
                "not-found"
              ]
            }
          }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "deploymentId",
        "snapshot",
        "order",
        "limit",
        "maxLimit",
        "items",
        "nextCursor",
        "totalIssued"
      ],
      "properties": {
        "schema": {
          "const": "hanamesh-own-issued-tokens-v1"
        },
        "deploymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "chainId",
            "mode",
            "evidence",
            "sourceCommit",
            "sourceRef",
            "blockNumber",
            "blockHash",
            "blockTimestamp",
            "confirmations",
            "requiredConfirmations",
            "launcher",
            "fromBlock"
          ],
          "properties": {
            "protocol": {
              "const": "release-quote-v2"
            },
            "chainId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "mode": {
              "enum": [
                "test-only",
                "production"
              ]
            },
            "evidence": {
              "enum": [
                "FIXTURE",
                "READ_ONLY_RPC"
              ]
            },
            "sourceCommit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sourceRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "blockNumber": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            "blockHash": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{64}$"
            },
            "blockTimestamp": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            },
            "confirmations": {
              "type": "integer",
              "minimum": 0
            },
            "requiredConfirmations": {
              "type": "integer",
              "minimum": 1
            },
            "launcher": {
              "type": "string",
              "pattern": "^0x[0-9a-f]{40}$"
            },
            "fromBlock": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]{0,77})$"
            }
          }
        },
        "order": {
          "const": "issued-time-token-desc"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxLimit": {
          "const": 50
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "totalIssued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "indexerError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "AUTH_REQUIRED",
                "AUTH_FORBIDDEN",
                "INDEXER_ISSUER_INPUT_INVALID",
                "INDEXER_ISSUER_CURSOR_INVALID",
                "INDEXER_ISSUER_CURSOR_FORBIDDEN",
                "INDEXER_ISSUER_WALLETS_CHANGED",
                "INDEXER_ISSUER_ORIGIN_REJECTED",
                "INDEXER_MARKET_HEAD_CHANGED",
                "INDEXER_ISSUED_NOT_READY",
                "INDEXER_ISSUED_SOURCE_REQUIRED",
                "INDEXER_ISSUED_SOURCE_INVALID",
                "INDEXER_ISSUER_SOURCE_INVALID",
                "INDEXER_ISSUER_SOURCE_UNAVAILABLE",
                "INDEXER_ISSUER_RESPONSE_TOO_LARGE"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "attachedAddressesError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "enum": [
                "AUTH_REQUIRED",
                "AUTH_FORBIDDEN",
                "IDENTITY_INPUT_INVALID",
                "AUTH_UNAVAILABLE",
                "IDENTITY_NOT_READY"
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "indexerHttpFailure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 400
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "INDEXER_ISSUER_INPUT_INVALID",
                        "INDEXER_ISSUER_CURSOR_INVALID"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 401
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTH_REQUIRED"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 403
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTH_FORBIDDEN",
                        "INDEXER_ISSUER_CURSOR_FORBIDDEN",
                        "INDEXER_ISSUER_ORIGIN_REJECTED"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 409
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "INDEXER_ISSUER_WALLETS_CHANGED",
                        "INDEXER_MARKET_HEAD_CHANGED",
                        "INDEXER_ISSUED_NOT_READY"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 503
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "INDEXER_ISSUED_SOURCE_REQUIRED",
                        "INDEXER_ISSUED_SOURCE_INVALID",
                        "INDEXER_ISSUER_SOURCE_INVALID",
                        "INDEXER_ISSUER_SOURCE_UNAVAILABLE",
                        "INDEXER_ISSUER_RESPONSE_TOO_LARGE"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "attachedAddressesHttpFailure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 400
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "IDENTITY_INPUT_INVALID"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 401
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTH_REQUIRED"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 403
            },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "code",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "enum": [
                        "AUTH_FORBIDDEN"
                      ]
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "statusCode",
            "body"
          ],
          "properties": {
            "statusCode": {
              "const": 413
            },
