{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "hanamesh-beneficiary-entitlements-v1",
 "title": "Custody beneficiary own-entitlement view (GET /v1/custody/launch-snapshots/:requestId/entitlements)",
 "description": "Canonical TypeScript type: BeneficiaryEntitlementView in src/snapshots/contracts.ts. Read-only projection of one persisted snapshot for the authenticated canonical principal. Errors: 401 CUSTODY_AUTH_REQUIRED, 400 CUSTODY_INPUT_INVALID, 404 CUSTODY_SNAPSHOT_NOT_FOUND, 403 CUSTODY_FORBIDDEN (no own entitlement), 409 CUSTODY_WALLET_BINDING_CONFLICT (snapshot freezes one wallet for two accounts or two wallets for one account: illegal input under owner rule Q-2026-10-09-P19-SHARED-WALLET-VIEW; nothing is served).",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "requestId", "snapshotId", "hanaId", "principalId", "chainId", "token", "hanaKey", "batchId", "policy", "entitlements", "ordinary", "reserved", "wallet", "provenance"],
 "properties": {
  "schema": {"const": "hanamesh-beneficiary-entitlements-v1"},
  "requestId": {"$ref": "#/$defs/uuid"}, "snapshotId": {"$ref": "#/$defs/uuid"}, "hanaId": {"$ref": "#/$defs/uuid"}, "principalId": {"$ref": "#/$defs/uuid"},
  "chainId": {"type": "integer"}, "token": {"$ref": "#/$defs/address"}, "hanaKey": {"$ref": "#/$defs/bytes32"}, "batchId": {"$ref": "#/$defs/bytes32"},
  "policy": {"type": "object", "additionalProperties": false, "required": ["mode", "testOnly"], "properties": {"mode": {"enum": ["test-only", "production"]}, "testOnly": {"type": "boolean"}}},
  "entitlements": {"type": "array", "items": {"type": "object", "additionalProperties": false,
   "required": ["entitlementId", "kind", "status", "route", "account", "walletBindingId"],
   "properties": {"entitlementId": {"$ref": "#/$defs/bytes32"}, "kind": {"enum": ["principal", "initiator"]}, "status": {"enum": ["bound", "pending"]}, "route": {"enum": ["ordinary", "reserved"]},
    "account": {"$ref": "#/$defs/addressOrZero"}, "walletBindingId": {"type": ["string", "null"]}}}, "$comment": "all bound entitlements share the principal's single frozen wallet"},
  "ordinary": {"type": "object", "additionalProperties": false, "required": ["contract", "root", "nonce", "entries"],
   "properties": {"contract": {"$ref": "#/$defs/address"}, "root": {"$ref": "#/$defs/bytes32"}, "nonce": {"$ref": "#/$defs/uint"},
    "entries": {"type": "array", "maxItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["account", "cumulativeAmount", "leaf", "proof", "claimable"],
     "properties": {"account": {"$ref": "#/$defs/address"}, "cumulativeAmount": {"$ref": "#/$defs/uint", "$comment": "cumulative leaf of the principal's single frozen wallet, not a per-entitlement amount"}, "leaf": {"$ref": "#/$defs/bytes32"}, "proof": {"type": "array", "items": {"$ref": "#/$defs/bytes32"}}, "claimable": {"const": true}}}}}},
  "reserved": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["contract", "batchId", "root", "nonce", "openedAt", "claimDeadline", "entries"],
   "properties": {"contract": {"$ref": "#/$defs/address"}, "batchId": {"$ref": "#/$defs/bytes32"}, "root": {"$ref": "#/$defs/bytes32"}, "nonce": {"$ref": "#/$defs/uint"}, "openedAt": {"type": ["string", "null"]}, "claimDeadline": {"type": ["string", "null"]},
    "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["entitlementId", "account", "cumulativeAmount", "leaf", "proof", "claimable"],
     "properties": {"entitlementId": {"$ref": "#/$defs/bytes32"}, "account": {"$ref": "#/$defs/addressOrZero"}, "cumulativeAmount": {"$ref": "#/$defs/uint"}, "leaf": {"$ref": "#/$defs/bytes32"}, "proof": {"type": "array", "items": {"$ref": "#/$defs/bytes32"}}, "claimable": {"type": "boolean", "$comment": "false for the zero-account placeholder"}}}}}}]},
  "wallet": {"type": "object", "additionalProperties": false, "required": ["chainId", "currentBindingMatches"], "properties": {"chainId": {"type": "integer"}, "currentBindingMatches": {"type": ["boolean", "null"]}}},
  "provenance": {"type": "object", "additionalProperties": false, "required": ["acceptedAt", "openingRecorded", "completedAt"], "properties": {"acceptedAt": {"type": "string"}, "openingRecorded": {"type": "boolean"}, "completedAt": {"type": ["string", "null"]}}}
 },
 "$defs": {
  "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
  "bytes32": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
  "address": {"type": "string", "pattern": "^0x(?!0{40})[0-9a-f]{40}$"},
  "addressOrZero": {"type": "string", "pattern": "^0x[0-9a-f]{40}$"},
  "uint": {"type": "string", "pattern": "^(?:0|[1-9][0-9]{0,77})$"}
 }
}
