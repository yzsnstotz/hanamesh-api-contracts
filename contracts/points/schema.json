{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "hanamesh-own-points-v1",
  "title": "OwnPointsDTO with Q-13 bindingStatus",
  "description": "Publication-only shape from provider declarations; does not add runtime validation to Custody. Whole points, milli/1000. BOUND is an account binding fact, never eligibility.",
  "type": "object",
  "required": [
    "bindingStatus",
    "hanas",
    "totalPoints",
    "subtotals"
  ],
  "properties": {
    "bindingStatus": {
      "enum": [
        "UNBOUND",
        "BOUND"
      ]
    },
    "hanas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "hanaId",
          "points",
          "pending",
          "breakdown",
          "userPoints",
          "pendingUserPoints",
          "creatorReward",
          "unclassified"
        ],
        "properties": {
          "hanaId": {
            "type": "string"
          },
          "points": {
            "type": "number"
          },
          "pending": {
            "type": "number"
          },
          "breakdown": {
            "type": "object",
            "required": [
              "install",
              "open",
              "use",
              "claimBonus",
              "creatorMirror",
              "launchInitiator"
            ],
            "properties": {
              "install": {
                "type": "number"
              },
              "open": {
                "type": "number"
              },
              "use": {
                "type": "number"
              },
              "claimBonus": {
                "type": "number"
              },
              "creatorMirror": {
                "type": "number"
              },
              "launchInitiator": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "userPoints": {
            "type": "object",
            "required": [
              "install",
              "open",
              "use",
              "launchInitiator",
              "total"
            ],
            "properties": {
              "install": {
                "type": "number"
              },
              "open": {
                "type": "number"
              },
              "use": {
                "type": "number"
              },
              "launchInitiator": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "pendingUserPoints": {
            "type": "object",
            "required": [
              "install",
              "open",
              "use",
              "launchInitiator",
              "total"
            ],
            "properties": {
              "install": {
                "type": "number"
              },
              "open": {
                "type": "number"
              },
              "use": {
                "type": "number"
              },
              "launchInitiator": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "creatorReward": {
            "type": "object",
            "required": [
              "claimBonus",
              "creatorMirror",
              "total"
            ],
            "properties": {
              "claimBonus": {
                "type": "number"
              },
              "creatorMirror": {
                "type": "number"
              },
              "total": {
                "type": "number"
              }
            },
            "additionalProperties": false
          },
          "unclassified": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "totalPoints": {
      "type": "number"
    },
    "subtotals": {
      "type": "object",
      "required": [
        "userPoints",
        "pendingUserPoints",
        "creatorReward",
        "unclassified"
      ],
      "properties": {
        "userPoints": {
          "type": "number"
        },
        "pendingUserPoints": {
          "type": "number"
        },
        "creatorReward": {
          "type": "number"
        },
        "unclassified": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
