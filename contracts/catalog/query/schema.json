{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanamesh.com/contracts/catalog/query-v1",
  "$defs": {
    "catalogDetailCount": {"type": ["integer", "null"], "minimum": 0, "maximum": 9007199254740991},
    "catalogDetailUnknownReason": {"enum": ["not_observed", "not_applicable", "source_unavailable", "history_unavailable"]},
    "detailSignals": {
      "type": "object",
      "required": ["stars", "npmDownloads30d", "storeInstalls30d", "checkedAt"],
      "properties": {
        "stars": {"$ref": "#/$defs/catalogDetailCount"},
        "repositoryStars": {"$ref": "#/$defs/catalogDetailCount"},
        "npmDownloads30d": {"$ref": "#/$defs/catalogDetailCount"},
        "storeInstalls30d": {"$ref": "#/$defs/catalogDetailCount"},
        "checkedAt": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"},
        "unknownReasons": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "stars": {"$ref": "#/$defs/catalogDetailUnknownReason"},
            "repositoryStars": {"$ref": "#/$defs/catalogDetailUnknownReason"},
            "npmDownloads30d": {"$ref": "#/$defs/catalogDetailUnknownReason"},
            "storeInstalls30d": {"$ref": "#/$defs/catalogDetailUnknownReason"},
            "checkedAt": {"$ref": "#/$defs/catalogDetailUnknownReason"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"required": ["stars"], "properties": {"stars": {"type": "null"}}},
          "then": {"required": ["unknownReasons"], "properties": {"unknownReasons": {"type": "object", "required": ["stars"], "properties": {"stars": true}}}},
          "else": {"properties": {"unknownReasons": {"not": {"type": "object", "required": ["stars"], "properties": {"stars": true}}}}}
        },
        {
          "if": {"required": ["repositoryStars"], "properties": {"repositoryStars": {"type": "null"}}},
          "then": {"required": ["unknownReasons"], "properties": {"unknownReasons": {"type": "object", "required": ["repositoryStars"], "properties": {"repositoryStars": true}}}},
          "else": {"properties": {"unknownReasons": {"not": {"type": "object", "required": ["repositoryStars"], "properties": {"repositoryStars": true}}}}}
        },
        {
          "if": {"required": ["npmDownloads30d"], "properties": {"npmDownloads30d": {"type": "null"}}},
          "then": {"required": ["unknownReasons"], "properties": {"unknownReasons": {"type": "object", "required": ["npmDownloads30d"], "properties": {"npmDownloads30d": true}}}},
          "else": {"properties": {"unknownReasons": {"not": {"type": "object", "required": ["npmDownloads30d"], "properties": {"npmDownloads30d": true}}}}}
        },
        {
          "if": {"required": ["storeInstalls30d"], "properties": {"storeInstalls30d": {"type": "null"}}},
          "then": {"required": ["unknownReasons"], "properties": {"unknownReasons": {"type": "object", "required": ["storeInstalls30d"], "properties": {"storeInstalls30d": true}}}},
          "else": {"properties": {"unknownReasons": {"not": {"type": "object", "required": ["storeInstalls30d"], "properties": {"storeInstalls30d": true}}}}}
        },
        {
          "if": {"required": ["checkedAt"], "properties": {"checkedAt": {"type": "null"}}},
          "then": {"required": ["unknownReasons"], "properties": {"unknownReasons": {"type": "object", "required": ["checkedAt"], "properties": {"checkedAt": true}}}},
          "else": {"properties": {"unknownReasons": {"not": {"type": "object", "required": ["checkedAt"], "properties": {"checkedAt": true}}}}}
        }
      ],
      "additionalProperties": false
    },
    "sitemapResponse": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "generation", "segmentCount", "segmentSize"],
          "properties": {
            "kind": {"const": "sitemap-manifest"},
            "generation": {"$ref": "#/$defs/boardHanaId"},
            "segmentCount": {"type": "integer", "minimum": 0, "maximum": 49999},
            "segmentSize": {"type": "integer", "minimum": 1, "maximum": 2000}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "generation", "segment", "items", "nextCursor"],
          "properties": {
            "kind": {"const": "sitemap-segment"},
            "generation": {"$ref": "#/$defs/boardHanaId"},
            "segment": {"type": "integer", "minimum": 1, "maximum": 49999},
            "items": {"type": "array", "maxItems": 200, "items": {
              "type": "object",
              "required": ["hanaId"],
              "properties": {"hanaId": {"$ref": "#/$defs/boardHanaId"}},
              "additionalProperties": false
            }},
            "nextCursor": {"anyOf": [{"$ref": "#/$defs/boardHanaId"}, {"type": "null"}]}
          },
          "additionalProperties": false
        }
      ]
    },
    "boardHanaId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "boardWatermark": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,512}$"
    },
    "boardChange": {
      "type": "object",
      "required": ["hanaId", "displayName", "listingStatus", "canonicalHanaId", "ownerPrincipalId"],
      "properties": {
        "hanaId": {"$ref": "#/$defs/boardHanaId"},
        "displayName": {"type": "string", "minLength": 1},
        "listingStatus": {"enum": ["listed", "delisted"]},
        "canonicalHanaId": {"anyOf": [{"$ref": "#/$defs/boardHanaId"}, {"type": "null"}]},
        "ownerPrincipalId": {"anyOf": [{"$ref": "#/$defs/boardHanaId"}, {"type": "null"}]}
      },
      "if": {"properties": {"listingStatus": {"const": "listed"}}, "required": ["listingStatus"]},
      "then": {"properties": {"canonicalHanaId": {"type": "null"}}},
      "additionalProperties": false
    },
    "boardChangePage": {
      "type": "object",
      "required": ["items", "cursor", "more"],
      "properties": {
        "items": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/boardChange"}},
        "cursor": {"$ref": "#/$defs/boardWatermark"},
        "more": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "cutoverReadiness": {
      "type": "object",
      "required": ["ready", "claimsReady", "popularityAsOf", "snapshot", "watermark"],
      "properties": {
        "ready": {"type": "boolean"},
        "claimsReady": {"type": "boolean"},
        "popularityAsOf": {"type": ["string", "null"]},
        "snapshot": {"type": "string", "pattern": "^[0-9]+$"},
        "watermark": {"$ref": "#/$defs/boardWatermark"}
      },
      "if": {"properties": {"claimsReady": {"const": true}, "popularityAsOf": {"type": "string"}}, "required": ["claimsReady", "popularityAsOf"]},
      "then": {"properties": {"ready": {"const": true}}},
      "else": {"properties": {"ready": {"const": false}}},
      "additionalProperties": false
    },
    "query": {
      "type": "object",
      "properties": {
        "q": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S",
          "description": "Use isCatalogQueryTextWithinBounds for the 512 raw UTF-8 bytes and 32 distinct normalized-term limits."
        },
        "searchMode": {
          "enum": [
            "keyword",
            "hybrid",
            "names"
          ]
        },
        "sort": {
          "enum": [
            "relevance",
            "popular",
            "latest",
            "stars",
            "downloads",
            "id",
            "trending"
          ]
        },
        "official": {
          "const": true
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "description": "Indexer removes identical items and sorts the remaining categories."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claim": {
          "enum": [
            "claimed",
            "unclaimed"
          ]
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "channel": {
          "enum": [
            "hanamesh",
            "claude",
            "codex",
            "dsh"
          ]
        },
        "installable": {
          "const": true
        },
        "domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subdivision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "includeInsufficient": {
          "type": "boolean",
          "default": true
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "ranking": {
          "const": "plugins"
        },
        "repoOwner": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 39,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        }
      },
      "required": [
        "searchMode",
        "sort",
        "limit"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "subdivision": [
          "domain"
        ]
      },
      "if": {
        "properties": {
          "searchMode": {
            "enum": [
              "hybrid",
              "names"
            ]
          }
        },
        "required": [
          "searchMode"
        ]
      },
      "then": {
        "required": [
          "q"
        ],
        "properties": {
          "q": {}
        }
      }
    },
    "facet": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "capped": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "count",
        "capped"
      ],
      "additionalProperties": false
    },
    "facets": {
      "type": "object",
      "properties": {
        "all": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "categories": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/facet"
          }
        },
        "sources": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/facet"
          }
        },
        "channels": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/facet"
          }
        },
        "domains": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/facet"
          }
        },
        "subdivisions": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/facet"
          }
        }
      },
      "required": [
        "all",
        "categories",
        "sources",
        "channels",
        "domains",
        "subdivisions"
      ],
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "hanaId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "matchKind": {
          "enum": [
            "name",
            "meaning"
          ]
        },
        "authority": {
          "type": "number"
        },
        "authorityVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "stars": {
          "type": [
            "number",
            "null"
          ]
        },
        "npmDownloads30d": {
          "type": [
            "number",
            "null"
          ]
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "hanaId",
        "rank",
        "tier",
        "authority",
        "authorityVersion",
        "stars",
        "npmDownloads30d",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "capped": {
          "type": "boolean"
        },
        "hiddenInsufficientCount": {
          "type": "integer",
          "minimum": 0
        },
        "hiddenInsufficientCountCapped": {
          "type": "boolean"
        },
        "facets": {
          "$ref": "#/$defs/facets"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "snapshot": {
          "type": "string"
        },
        "policyVersion": {
          "type": "integer",
          "minimum": 1
        },
        "searchMode": {
          "enum": [
            "keyword",
            "hybrid",
            "names"
          ]
        },
        "indexReady": {
          "type": "boolean"
        },
        "directoryReady": {
          "type": "boolean"
        },
        "rankingReady": {
          "type": "boolean"
        },
        "rankingVersion": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "items",
        "total",
        "capped",
        "hiddenInsufficientCount",
        "hiddenInsufficientCountCapped",
        "facets",
        "nextCursor",
        "snapshot",
        "policyVersion",
        "searchMode",
        "indexReady"
      ],
      "additionalProperties": false
    },
    "loggedPage": {
      "type": "object",
      "properties": {
        "page": {
          "$ref": "#/$defs/page"
        },
        "searchId": {
          "type": [
            "string",
            "null"
          ]
        },
        "semanticNotice": {
          "enum": [
            "SEMANTIC_FREE_QUOTA_EXHAUSTED",
            "SEMANTIC_UNAVAILABLE",
            null
          ]
        }
      },
      "required": [
        "page",
        "searchId",
        "semanticNotice"
      ],
      "additionalProperties": false
    },
    "names": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "properties": {
              "hanaId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "name": {
                "type": "string"
              },
              "rank": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "hanaId",
              "name",
              "rank"
            ],
            "additionalProperties": false
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "required": [
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    },
    "semanticCandidates": {
      "type": "object",
      "properties": {
        "semanticHanaIds": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        }
      },
      "required": [
        "semanticHanaIds"
      ],
      "additionalProperties": false
    },
    "httpCard": {
      "type": "object",
      "properties": {
        "hanaId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "displayName": {
          "type": "string"
        },
        "githubRepo": {
          "type": [
            "string",
            "null"
          ]
        },
        "repoSubdirectory": {
          "type": [
            "string",
            "null"
          ]
        },
        "npmPackageName": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "object",
          "properties": {
            "en": {
              "type": [
                "string",
                "null"
              ]
            },
            "zh": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "en",
            "zh"
          ],
          "additionalProperties": false
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "publisher": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "url"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerPrincipalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceId": {
                "type": "string"
              },
              "sourceRef": {
                "type": "string"
              },
              "sourceUrl": {
                "type": "string"
              },
              "lastSeenAt": {
                "type": "string"
              }
            },
            "required": [
              "sourceId",
              "sourceRef",
              "sourceUrl",
              "lastSeenAt"
            ],
            "additionalProperties": false
          }
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "hanamesh",
              "claude",
              "codex",
              "dsh"
            ]
          }
        },
        "installMethods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "enum": [
                  "hanamesh",
                  "claude",
                  "codex",
                  "dsh"
                ]
              },
              "kind": {
                "enum": [
                  "npm",
                  "github",
                  "agent"
                ]
              },
              "spec": {
                "type": "string"
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "allowBuild": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sourceId": {
                "type": "string"
              },
              "sourceRef": {
                "type": "string"
              },
              "target": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "npm"
                      },
                      "name": {
                        "type": "string"
                      },
                      "version": {
                        "type": "string"
                      },
                      "allowBuild": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "source",
                      "name",
                      "version",
                      "allowBuild"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "source": {
                        "const": "github"
                      },
                      "repo": {
                        "type": "string"
                      },
                      "ref": {
                        "type": "string"
                      },
                      "path": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "packageName": {
                        "type": "string"
                      },
                      "allowBuild": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "source",
                      "repo",
                      "ref",
                      "path",
                      "packageName",
                      "allowBuild"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "targetUnavailableReason": {
                "type": "string"
              },
              "npmOwnership": {
                "type": "object",
                "properties": {
                  "status": {
                    "enum": [
                      "matched",
                      "mismatch",
                      "missing-repository",
                      "not-found",
                      "unchecked"
                    ]
                  },
                  "repository": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "repository"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "channel",
              "kind",
              "spec",
              "command",
              "allowBuild",
              "sourceId",
              "sourceRef"
            ],
            "additionalProperties": false
          }
        },
        "oneClickInstall": {
          "type": "object",
          "properties": {
            "allowed": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "allowed",
            "reason"
          ],
          "additionalProperties": false
        },
        "npmOwnership": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "matched",
                    "mismatch",
                    "missing-repository",
                    "not-found",
                    "unchecked"
                  ]
                },
                "repository": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "status",
                "repository"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "browseOnlyReason": {
          "enum": [
            null,
            "no-install-method",
            "unrecognized-install-command"
          ]
        },
        "official": {
          "type": "boolean"
        },
        "suite": {
          "type": "object"
        },
        "claimStatus": {
          "type": "object",
          "properties": {
            "state": {
              "enum": [
                "unclaimed",
                "claiming",
                "claimed",
                "on_chain",
                "withdrawable"
              ]
            },
            "claimedByPrincipalId": {
              "type": [
                "string",
                "null"
              ]
            },
            "firstClaimedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "state",
            "claimedByPrincipalId"
          ],
          "additionalProperties": false
        },
        "claimStatusError": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        },
        "discovery": {
          "$ref": "https://hanamesh.com/contracts/catalog/discovery-v1#/$defs/listFields"
        },
        "signals": {
