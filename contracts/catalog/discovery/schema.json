        "rulesVersion",
        "projectionAt"
      ],
      "additionalProperties": false
    },
    "localizedFact": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "https://hanamesh.com/contracts/catalog/localized-v2"
