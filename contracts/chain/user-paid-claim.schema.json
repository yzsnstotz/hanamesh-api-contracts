{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanamesh.local/contracts/user-paid-claim/v1",
  "title": "User-paid claim identifiers, exact wallet plan and canonical results",
  "oneOf": [
    {
      "$ref": "#/$defs/Plan"
    },
    {
      "$ref": "#/$defs/Result"
    },
    {
      "$ref": "#/$defs/Readback"
    }
  ],
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "hanaId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": [
            "ordinary",
            "reserved"
          ]
        }
      },
      "required": [
        "operationId",
        "principalId",
        "hanaId",
        "requestId",
        "route"
      ],
      "additionalProperties": false
    },
    "Plan": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "hanaId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": [
            "ordinary",
            "reserved"
          ]
        },
        "schema": {
          "const": "hanamesh-user-paid-claim-plan-v1"
        },
        "mode": {
          "enum": [
            "test-only",
            "testnet"
          ]
        },
        "chainId": {
          "enum": [
            31337,
            11155111
          ]
        },
        "issuer": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "distributor": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "reservedDistributor": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "token": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "hanaKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "requestKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "root": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "batchId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "entitlementId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cumulativeAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "proof": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "broadcaster": {
          "const": "user-wallet"
        },
        "preparedBlock": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "hash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          },
          "required": [
            "number",
            "hash"
          ],
          "additionalProperties": false
        },
        "previousClaimed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "preparedBalance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "transaction": {
          "type": "object",
          "properties": {
            "chainId": {
              "enum": [
                "0x7a69",
                "0xaa36a7"
              ]
            },
            "from": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "to": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "data": {
              "type": "string",
              "pattern": "^0x([0-9a-fA-F]{2})*$"
            },
            "value": {
              "const": "0x0"
            }
          },
          "required": [
            "chainId",
            "from",
            "to",
            "data",
            "value"
          ],
          "additionalProperties": false
        },
        "claimAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "funding": {
          "$ref": "#/$defs/Funding"
        }
      },
      "required": [
        "operationId",
        "principalId",
        "hanaId",
        "requestId",
        "route",
        "schema",
        "mode",
        "chainId",
        "issuer",
        "distributor",
        "reservedDistributor",
        "producer",
        "authorityRef",
        "snapshotId",
        "account",
        "token",
        "hanaKey",
        "requestKey",
        "root",
        "batchId",
        "entitlementId",
        "cumulativeAmount",
        "proof",
        "digest",
        "broadcaster",
        "preparedBlock",
        "previousClaimed",
        "preparedBalance",
        "transaction",
        "claimAmount",
        "funding"
      ],
      "additionalProperties": false
    },
    "Result": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "hanaId": {
          "type": "string",
          "minLength": 1
        },
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "route": {
          "enum": [
            "ordinary",
            "reserved"
          ]
        },
        "schema": {
          "const": "hanamesh-user-paid-claim-result-v1"
        },
        "mode": {
          "enum": [
            "test-only",
            "testnet"
          ]
        },
        "chainId": {
          "enum": [
            31337,
            11155111
          ]
        },
        "issuer": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "distributor": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "reservedDistributor": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "authorityRef": {
          "type": "string",
          "minLength": 1
        },
        "snapshotId": {
          "type": "string",
          "minLength": 1
        },
        "account": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "token": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "hanaKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "requestKey": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "root": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "batchId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "entitlementId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cumulativeAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "proof": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{64}$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "broadcaster": {
          "const": "user-wallet"
        },
        "preparedBlock": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "hash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          },
          "required": [
            "number",
            "hash"
          ],
          "additionalProperties": false
        },
        "previousClaimed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "preparedBalance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "transaction": {
          "type": "object",
          "properties": {
            "chainId": {
              "enum": [
                "0x7a69",
                "0xaa36a7"
              ]
            },
            "from": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "to": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "data": {
              "type": "string",
              "pattern": "^0x([0-9a-fA-F]{2})*$"
            },
            "value": {
              "const": "0x0"
            }
          },
          "required": [
            "chainId",
            "from",
            "to",
            "data",
            "value"
          ],
          "additionalProperties": false
        },
        "status": {
          "enum": [
            "complete",
            "pending",
            "unknown",
            "reverted"
          ]
        },
        "reason": {
          "enum": [
            "user-hash-not-bound",
            "no-canonical-receipt",
            null
          ]
        },
        "transactionHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "canonical": {
          "type": "boolean"
        },
        "blockNumber": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "effect": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "token": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "account": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{40}$"
                },
                "root": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                },
                "batchId": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                },
                "entitlementId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^0x[0-9a-fA-F]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cumulativeAmount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "creditedAmount": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "claimed": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "balance": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              },
              "required": [
                "token",
                "account",
                "root",
                "batchId",
                "entitlementId",
                "cumulativeAmount",
                "creditedAmount",
                "claimed",
                "balance"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "claimAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "funding": {
          "$ref": "#/$defs/Funding"
        }
      },
      "required": [
        "operationId",
        "principalId",
        "hanaId",
        "requestId",
        "route",
        "schema",
        "mode",
        "chainId",
        "issuer",
        "distributor",
        "reservedDistributor",
        "producer",
        "authorityRef",
        "snapshotId",
        "account",
        "token",
        "hanaKey",
        "requestKey",
        "root",
        "batchId",
        "entitlementId",
        "cumulativeAmount",
        "proof",
        "digest",
        "broadcaster",
        "preparedBlock",
        "previousClaimed",
        "preparedBalance",
        "transaction",
        "status",
        "reason",
        "transactionHash",
        "canonical",
        "blockNumber",
        "blockHash",
        "effect",
        "claimAmount",
        "funding"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "effect": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "account": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "root": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "batchId": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "entitlementId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^0x[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "cumulativeAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "creditedAmount": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "claimed": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  },
                  "balance": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]*)$"
                  }
                },
                "required": [
                  "token",
                  "account",
                  "root",
                  "batchId",
                  "entitlementId",
                  "cumulativeAmount",
                  "creditedAmount",
                  "claimed",
                  "balance"
                ],
                "additionalProperties": false
              },
              "canonical": {
                "const": true
              },
              "transactionHash": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              },
              "blockNumber": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "blockHash": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{64}$"
              }
            }
          }
        }
      ]
    },
    "Readback": {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/Result"
        },
        "readback": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "blockNumber": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "blockHash": {
                  "type": "string",
                  "pattern": "^0x[0-9a-fA-F]{64}$"
                },
                "canonical": {
                  "const": true
                },
                "claimed": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                },
                "balance": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$"
                }
              },
              "required": [
                "blockNumber",
                "blockHash",
                "canonical",
                "claimed",
                "balance"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "result",
        "readback"
      ],
      "additionalProperties": false
    },
    "Funding": {
      "type": "object",
      "properties": {
        "status": {
          "const": "verified"
        },
        "canonical": {
          "const": true
        },
        "unit": {
          "const": "token-base-units"
        },
        "tokenDecimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "source": {
          "enum": [
            "Distributor.distributions + HanaToken.balanceOf/decimals",
            "ReservedDistributor.batches + HanaToken.balanceOf/decimals"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "block": {
          "type": "object",
          "properties": {
            "number": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "hash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}$"
            }
          },
          "required": [
            "number",
            "hash"
          ],
          "additionalProperties": false
        },
        "allocatedAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "totalClaimed": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "remainingAllocation": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "distributorBalance": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "sufficientForClaim": {
          "const": true
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "canonical",
        "unit",
        "tokenDecimals",
        "source",
        "target",
        "block",
        "allocatedAmount",
        "totalClaimed",
        "remainingAllocation",
        "distributorBalance",
        "sufficientForClaim"
      ]
    }
  }
}
