{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hanamesh.local/schema/confirmed-launch-v2",
  "title": "Trusted canonical ConfirmedLaunch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "hanaId",
    "principalId",
    "chainId",
    "hanaKey",
    "requestKey",
    "issuer",
    "token",
    "distributor",
    "reservedDistributor",
    "platformWallet",
    "ordinarySigner",
    "reservedSigner",
    "authorizationHash",
    "subject",
    "sourceCommitment",
    "transactionHash",
    "blockNumber",
    "paidToken",
    "paidAmount",
    "initialPoolAmount",
    "tokenDecimals",
    "confirmedAt",
    "claimWindowSeconds"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical UUID v4 required by the existing Custody consumer."
    },
    "hanaId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical UUID v4 required by the existing Custody consumer."
    },
    "principalId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "description": "Canonical UUID v4 required by the existing Custody consumer."
    },
    "chainId": {
      "type": "integer",
      "enum": [
        31337,
        11155111
      ]
    },
    "hanaKey": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "requestKey": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "token": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "distributor": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "reservedDistributor": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "platformWallet": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "ordinarySigner": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "reservedSigner": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "authorizationHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "sourceCommitment": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "transactionHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "blockNumber": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "paidToken": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "paidAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "initialPoolAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "tokenDecimals": {
      "type": "integer",
      "const": 18
    },
    "confirmedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Canonical issuance receipt block.timestamp seconds converted to UTC ISO8601 Z, at most milliseconds."
    },
    "claimWindowSeconds": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    }
  }
}
