{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "@hanamesh/api-contracts/contracts/usage-local/schema.json",
  "title": "hanameshUsage local service contract (C-USAGE-LOCAL), record + health",
  "description": "Data shapes of the Cordis service `hanameshUsage` as consumed by app-host. Methods are listed under x-hanamesh. Source of truth: hanamesh-usage src/host/contracts.d.ts and src/host/record.js (main 7517d76).",
  "x-hanamesh": {
    "service": "hanameshUsage",
    "methods": {
      "record": {
        "input": "#/$defs/RecordInput",
        "returns": "Promise<#/$defs/RecordResult>",
        "note": "never rejects; refusal is disposition 'rejected' with code. Consent other than 'granted' returns 'withheld' before any validation."
      },
      "health": {
        "returns": "#/$defs/HealthSnapshot",
        "note": "synchronous observation; never throws"
      }
    },
    "http": {
      "health": "GET /api/hanamesh/usage/health → HealthSnapshot; failure → 503 {error:'USAGE_UNAVAILABLE'}"
    }
  },
  "$defs": {
    "HanaRef": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(?:@[A-Za-z0-9][A-Za-z0-9._-]*/)?[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "npm package name; also rejected when it contains sk-, ghp_, secret, password or api key"
    },
    "UsageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "model",
        "count"
      ],
      "properties": {
        "providerId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@+-]{0,127}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      }
    },
    "RecordInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hanaRef",
        "action",
        "idempotencyKey",
        "sourcePlugin"
      ],
      "properties": {
        "hanaRef": {
          "$ref": "#/$defs/HanaRef"
        },
        "action": {
          "enum": [
            "open",
            "use"
          ]
        },
        "occurredAt": {
          "type": "string",
          "description": "ISO-8601 as produced by Date#toISOString; within 90 days before and 5 minutes after now; default now"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]*$",
          "description": "also rejected when secret-like (sk-, ghp_, github_pat_, xox?-, eyJ, bearer, private key, password, secret, api key)"
        },
        "sourcePlugin": {
          "$ref": "#/$defs/HanaRef"
        },
        "sourceHanaRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/HanaRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetRef": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,159}$"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageReceipt"
            },
            {
              "type": "null"
            }
          ],
          "description": "only with action 'use'"
        }
      }
    },
    "RecordResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "recorded",
            "duplicate",
            "withheld",
            "rejected"
          ]
        },
        "eventId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-5[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "description": "UUIDv5 of JSON [deviceId, sourcePlugin, idempotencyKey]"
        },
        "code": {
          "enum": [
            "INVALID_RECORD_INPUT",
            "DEVICE_UNAVAILABLE",
            "EVENTS_CAPACITY_REACHED",
            "EVENT_IDENTITY_CONFLICT",
            "RECORD_FAILED"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "recorded",
                  "duplicate"
                ]
              }
            }
          },
          "then": {
            "required": [
              "eventId"
            ],
            "not": {
              "required": [
                "code"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "rejected"
              }
            }
          },
          "then": {
            "required": [
              "code"
            ],
            "not": {
              "required": [
                "eventId"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "withheld"
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "code"
                  ]
                },
                {
                  "required": [
                    "eventId"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "HealthSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pending",
        "recoveryComplete",
        "failures",
        "consent",
        "core",
        "deviceId",
        "outbox",
        "derive",
        "withdrawal",
        "inventory"
      ],
      "properties": {
        "pending": {
          "type": "integer",
          "minimum": 0
        },
        "recoveryComplete": {
          "type": "boolean"
        },
        "failures": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "consent": {
          "enum": [
            "granted",
            "withheld",
            "unknown"
          ]
        },
        "core": {
          "enum": [
            "present",
            "absent",
            "incompatible"
          ]
        },
        "deviceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "outbox": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "pending",
            "sent",
            "duplicate",
            "rejected",
            "lastUploadAt",
            "nextAttemptAt",
            "lastError"
          ],
          "properties": {
            "state": {
              "enum": [
                "idle",
                "uploading",
                "backoff",
                "offline",
                "stopped"
              ]
            },
            "pending": {
              "type": "integer",
              "minimum": 0
            },
            "sent": {
              "type": "integer",
              "minimum": 0
            },
            "duplicate": {
              "type": "integer",
              "minimum": 0
            },
            "rejected": {
              "type": "integer",
              "minimum": 0
            },
            "lastUploadAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "nextAttemptAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "lastError": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "derive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "skipped"
          ],
          "properties": {
            "skipped": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "consentWithheld",
                "executorUnavailable",
                "timeUnavailable",
                "noDevice"
              ],
              "properties": {
                "consentWithheld": {
                  "type": "integer",
                  "minimum": 0
                },
                "executorUnavailable": {
                  "type": "integer",
                  "minimum": 0
                },
                "timeUnavailable": {
                  "type": "integer",
                  "minimum": 0
                },
                "noDevice": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "withdrawal": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requestedAt",
                "deviceId",
                "state",
                "attempts",
                "deletedEvents",
                "lastError"
              ],
              "properties": {
                "requestedAt": {
                  "type": "string"
                },
                "deviceId": {
                  "type": "string"
                },
                "state": {
                  "enum": [
                    "pending",
                    "sent",
                    "offline"
                  ]
                },
                "attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "deletedEvents": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "lastError": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "inventory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "source",
            "lastScanAt",
            "detail"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "source": {
              "enum": [
                "loader",
                "plugin-inventory",
                "none"
              ]
            },
            "lastScanAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "detail": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "package",
                    "serviceKey",
                    "methods"
                  ],
                  "properties": {
                    "package": {
                      "type": "string"
                    },
                    "serviceKey": {
                      "type": "string"
                    },
                    "methods": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
