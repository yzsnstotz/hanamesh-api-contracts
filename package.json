{
  "name": "@hanamesh/api-contracts",
  "version": "0.29.0",
  "description": "Current quote-v2 provider declarations, ABI artifacts and C09 search-miss response schemas.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzsnstotz/hanamesh-api-contracts.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./chain/quote-v2": {
      "types": "./contracts/chain/quote-v2/index.d.ts",
      "default": "./contracts/chain/quote-v2/index.js"
    },
    "./chain/quote-v2/BatchVestingDistributorQuoteV2.json": "./contracts/chain/quote-v2/BatchVestingDistributorQuoteV2.json",
    "./chain/quote-v2/provenance.json": "./contracts/chain/quote-v2/provenance.json",
    "./chain/quote-v2/HanaBondQuoteV2.json": "./contracts/chain/quote-v2/HanaBondQuoteV2.json",
    "./chain/quote-v2/HanaLauncherQuoteV2.json": "./contracts/chain/quote-v2/HanaLauncherQuoteV2.json",
    "./chain/quote-v2/HanaTokenQuoteV2.json": "./contracts/chain/quote-v2/HanaTokenQuoteV2.json",
    "./chain/quote-v2/manifest.json": "./contracts/chain/quote-v2/manifest.json",
    "./chain/quote-v2/WETH9.json": "./contracts/chain/quote-v2/WETH9.json",
    "./chain/quote-v2/HanaBondFactoryQuoteV2.json": "./contracts/chain/quote-v2/HanaBondFactoryQuoteV2.json",
    "./host/search-miss-export": {
      "types": "./contracts/host/search-miss-export/index.d.ts",
      "default": "./contracts/host/search-miss-export/index.js"
    },
    "./host/search-miss-export/success.schema.json": "./contracts/host/search-miss-export/success.schema.json",
    "./host/search-miss-export/error.schema.json": "./contracts/host/search-miss-export/error.schema.json",
    "./host/ops-manifest": {
      "types": "./contracts/host/ops-manifest/index.d.ts",
      "default": "./contracts/host/ops-manifest/index.js"
    },
    "./host/ops-manifest/success.schema.json": "./contracts/host/ops-manifest/success.schema.json",
    "./ops/observatory": {
      "types": "./contracts/ops/observatory/index.d.ts",
      "default": "./contracts/ops/observatory/index.js"
    },
    "./ops/observatory/success.schema.json": "./contracts/ops/observatory/success.schema.json",
    "./ops/observatory/contribution.schema.json": "./contracts/ops/observatory/contribution.schema.json",
    "./host/ops-manifest/page.schema.json": "./contracts/host/ops-manifest/page.schema.json",
    "./ops/observatory/metrics.ops-v3.json": "./contracts/ops/observatory/metrics.ops-v3.json",
    "./catalog/discovery": {
      "types": "./contracts/catalog/discovery/index.d.ts",
      "default": "./contracts/catalog/discovery/index.js"
    },
    "./catalog/discovery/schema.json": "./contracts/catalog/discovery/schema.json",
    "./catalog/localized": {
      "types": "./contracts/catalog/localized/index.d.ts",
      "default": "./contracts/catalog/localized/index.js"
    },
    "./catalog/localized/schema.json": "./contracts/catalog/localized/schema.json",
    "./issuer/read": {
      "types": "./contracts/issuer/read/index.d.ts",
      "default": "./contracts/issuer/read/index.js"
    },
    "./issuer/read/schema.json": "./contracts/issuer/read/schema.json",
    "./catalog/query": {
      "types": "./contracts/catalog/query/index.d.ts",
      "default": "./contracts/catalog/query/index.js"
    },
    "./catalog/query/schema.json": "./contracts/catalog/query/schema.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "contracts/chain/quote-v2",
    "contracts/host/search-miss-export",
    "docs/search-miss-export.md",
    "contracts/host/ops-manifest",
    "docs/ops-manifest.md",
    "contracts/ops/observatory",
    "docs/observatory.md",
    "docs/observatory-ops-v3.md",
    "contracts/catalog/discovery",
    "docs/catalog-discovery.md",
    "contracts/catalog/localized",
    "docs/catalog-localized.md",
    "contracts/issuer/read",
    "docs/issuer-read.md",
    "contracts/catalog/query",
    "docs/catalog-query.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && tsc -p test/tsconfig.json",
    "test:localized": "node --test test/catalog-discovery.test.mjs test/catalog-discovery-fixtures.test.mjs test/catalog-localized.test.mjs && tsc -p test/tsconfig.json",
    "test:issuer-read": "node --test test/issuer-read.test.mjs && tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "viem": "^2.56.9"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "ajv": "8.20.0",
    "typescript": "^5.9.3",
    "viem": "2.56.9"
  }
}
