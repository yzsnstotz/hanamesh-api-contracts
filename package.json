{
  "name": "@hanamesh/api-contracts",
  "version": "0.22.0",
  "description": "Consumed quote-v2 provider declarations and exact current contract artifacts.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzsnstotz/hanamesh-api-contracts.git"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./chain/quote-v2": {
      "types": "./contracts/chain/quote-v2/index.d.ts",
      "default": "./contracts/chain/quote-v2/index.js"
    },
    "./chain/quote-v2/BatchVestingDistributorQuoteV2.json": "./contracts/chain/quote-v2/BatchVestingDistributorQuoteV2.json",
    "./chain/quote-v2/provenance.json": "./contracts/chain/quote-v2/provenance.json",
    "./chain/quote-v2/HanaBondQuoteV2.json": "./contracts/chain/quote-v2/HanaBondQuoteV2.json",
    "./chain/quote-v2/HanaLauncherQuoteV2.json": "./contracts/chain/quote-v2/HanaLauncherQuoteV2.json",
    "./chain/quote-v2/HanaTokenQuoteV2.json": "./contracts/chain/quote-v2/HanaTokenQuoteV2.json",
    "./chain/quote-v2/manifest.json": "./contracts/chain/quote-v2/manifest.json",
    "./chain/quote-v2/WETH9.json": "./contracts/chain/quote-v2/WETH9.json",
    "./chain/quote-v2/HanaBondFactoryQuoteV2.json": "./contracts/chain/quote-v2/HanaBondFactoryQuoteV2.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "contracts/chain/quote-v2"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs && tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "viem": "^2.56.9"
  },
  "peerDependenciesMeta": {
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "viem": "2.56.9",
    "@types/node": "24.3.0"
  }
}
